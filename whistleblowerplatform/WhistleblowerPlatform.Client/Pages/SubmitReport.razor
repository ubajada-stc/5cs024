@page "/submit"
@inject HttpClient Http
@inject NavigationManager Navigation

<div class="container mt-4" style="max-width: 720px;">
    <h2 class="mb-4">Submit a Report</h2>

    <div class="alert alert-info">
        <strong>Your privacy is protected.</strong> All data is encrypted in your browser before being sent.
        The server never sees your report in plaintext.
    </div>

    @if (errorMessage != null)
    {
        <div class="alert alert-danger">@errorMessage</div>
    }

    <div class="mb-3">
        <label class="form-label">Category</label>
        <select class="form-select" @bind="selectedCategoryId">
            <option value="">-- Select a category --</option>
            @if (categories != null)
            {
                @foreach (var category in categories)
                {
                    <option value="@category.CategoryId">@category.Name</option>
                }
            }
        </select>
    </div>

    <div class="mb-3">
        <label class="form-label">Report Details <span class="text-danger">*</span></label>
        <textarea class="form-control" rows="8" @bind="reportText"
                  placeholder="Describe the misconduct you wish to report..."></textarea>
    </div>

    <div class="card mb-3">
        <div class="card-header">
            Optional: Identify Yourself
        </div>
        <div class="card-body">
            <div class="alert alert-warning mb-3">
                <strong>These fields are entirely OPTIONAL.</strong> Providing your identity is voluntary.
                If provided, this information will be encrypted and only visible to the investigator.
            </div>
            <div class="mb-2">
                <label class="form-label">Name</label>
                <input type="text" class="form-control" @bind="identityName" />
            </div>
            <div class="mb-2">
                <label class="form-label">Email</label>
                <input type="email" class="form-control" @bind="identityEmail" />
            </div>
            <div class="mb-2">
                <label class="form-label">Phone</label>
                <input type="tel" class="form-control" @bind="identityPhone" />
            </div>
        </div>
    </div>

    <button class="btn btn-primary btn-lg w-100" @onclick="HandleSubmit" disabled="@isSubmitting">
        @if (isSubmitting)
        {
            <span class="spinner-border spinner-border-sm me-2"></span>
            <span>Submitting...</span>
        }
        else
        {
            <span>Submit Report</span>
        }
    </button>
</div>

@code {
    private List<CategoryDto>? categories;
    private string? selectedCategoryId;
    private string reportText = "";
    private string identityName = "";
    private string identityEmail = "";
    private string identityPhone = "";
    private string? errorMessage;
    private bool isSubmitting = false;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            categories = await Http.GetFromJsonAsync<List<CategoryDto>>("api/reports/categories");
        }
        catch
        {
            errorMessage = "Failed to load categories. Please refresh the page.";
        }
    }

    private async Task HandleSubmit()
    {
        errorMessage = null;

        if (string.IsNullOrWhiteSpace(reportText))
        {
            errorMessage = "Please enter your report details.";
            return;
        }

        isSubmitting = true;

        try
        {
            // =====================================================
            // TEMPORARY: Send plaintext for now.
            // In the next step we will add client-side encryption
            // using the CryptoService (Web Crypto API via JS interop).
            // This placeholder lets us verify the full flow works
            // end-to-end before adding the encryption layer.
            // =====================================================

            var payload = new
            {
                tokenHash = Convert.ToBase64String(new byte[32]),        // placeholder
                categoryId = string.IsNullOrEmpty(selectedCategoryId) ? (int?)null : int.Parse(selectedCategoryId),
                encryptedContent = Convert.ToBase64String(
                    System.Text.Encoding.UTF8.GetBytes(reportText)),     // placeholder — not actually encrypted
                encryptedKeyEnvelope = Convert.ToBase64String(new byte[16]),
                wbKeyEnvelope = Convert.ToBase64String(new byte[16]),
                wbPublicKey = Convert.ToBase64String(new byte[16]),
                encryptedWbPrivateKey = Convert.ToBase64String(new byte[16]),
                wbKeySalt = Convert.ToBase64String(new byte[16]),
                selfIdentified = !string.IsNullOrEmpty(identityName) ||
                                 !string.IsNullOrEmpty(identityEmail) ||
                                 !string.IsNullOrEmpty(identityPhone),
                encryptedIdentity = (string?)null,
                encryptedIdentityKeyEnvelope = (string?)null
            };

            var response = await Http.PostAsJsonAsync("api/reports", payload);

            if (response.IsSuccessStatusCode)
            {
                var result = await response.Content.ReadFromJsonAsync<SubmitResultDto>();
                Navigation.NavigateTo($"/token/{result?.CaseNumber}");
            }
            else
            {
                var error = await response.Content.ReadAsStringAsync();
                errorMessage = $"Submission failed: {error}";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"An error occurred: {ex.Message}";
        }
        finally
        {
            isSubmitting = false;
        }
    }

    private class CategoryDto
    {
        public int CategoryId { get; set; }
        public string Name { get; set; } = "";
        public string? Description { get; set; }
    }

    private class SubmitResultDto
    {
        public string CaseNumber { get; set; } = "";
    }
}