@page "/submit"
@inject HttpClient Http
@inject NavigationManager Navigation
@inject WhistleblowerPlatform.Client.Services.CryptoService Crypto

<div class="container mt-4" style="max-width: 720px;">
    <h2 class="mb-4">Submit a Report</h2>

    <div class="alert alert-info">
        <strong>Your privacy is protected.</strong> All data is encrypted in your browser before being sent.
        The server never sees your report in plaintext.
    </div>

    @if (errorMessage != null)
    {
        <div class="alert alert-danger">@errorMessage</div>
    }

    <div class="mb-3">
        <label class="form-label">Category</label>
        <select class="form-select" @bind="selectedCategoryId">
            <option value="">-- Select a category --</option>
            @if (categories != null)
            {
                @foreach (var category in categories)
                {
                    <option value="@category.CategoryId">@category.Name</option>
                }
            }
        </select>
    </div>

    <div class="mb-3">
        <label class="form-label">Report Details <span class="text-danger">*</span></label>
        <textarea class="form-control" rows="8" @bind="reportText"
                  placeholder="Describe the misconduct you wish to report..."></textarea>
    </div>

    <div class="card mb-3">
        <div class="card-header">
            Attachments
        </div>
        <div class="card-body">
            <p class="text-muted">
                Upload supporting documents, images, or audio files.
                Max 1 GB per file, 5 GB total. Metadata (EXIF, GPS, author) will be stripped before encryption.
            </p>
            <InputFile OnChange="OnFilesSelected" multiple class="form-control" />

            @if (selectedFiles.Count > 0)
            {
                <ul class="list-group mt-3">
                    @foreach (var file in selectedFiles)
                    {
                        <li class="list-group-item d-flex justify-content-between align-items-center">
                            <span>@file.Name <small class="text-muted">(@FormatFileSize(file.Size))</small></span>
                            <button class="btn btn-sm btn-outline-danger" @onclick="() => RemoveFile(file)">Remove</button>
                        </li>
                    }
                </ul>
                <p class="text-muted mt-2 mb-0">
                    Total: @FormatFileSize(selectedFiles.Sum(f => f.Size))
                </p>
            }

            @if (fileError != null)
            {
                <div class="alert alert-danger mt-2 mb-0">@fileError</div>
            }
        </div>
    </div>

    <div class="card mb-3">
        <div class="card-header">
            Optional: Identify Yourself
        </div>
        <div class="card-body">
            <div class="alert alert-warning mb-3">
                <strong>These fields are entirely OPTIONAL.</strong> Providing your identity is voluntary.
                If provided, this information will be encrypted and only visible to the investigator.
            </div>
            <div class="mb-2">
                <label class="form-label">Name</label>
                <input type="text" class="form-control" @bind="identityName" />
            </div>
            <div class="mb-2">
                <label class="form-label">Email</label>
                <input type="email" class="form-control" @bind="identityEmail" />
            </div>
            <div class="mb-2">
                <label class="form-label">Phone</label>
                <input type="tel" class="form-control" @bind="identityPhone" />
            </div>
        </div>
    </div>

    <button class="btn btn-primary btn-lg w-100" @onclick="HandleSubmit" disabled="@isSubmitting">
        @if (isSubmitting)
        {
            <span class="spinner-border spinner-border-sm me-2"></span>
            <span>@submitStatus</span>
        }
        else
        {
            <span>Submit Report</span>
        }
    </button>
</div>

@code {
    private List<CategoryDto>? categories;
    private string? selectedCategoryId;
    private string reportText = "";
    private string identityName = "";
    private string identityEmail = "";
    private string identityPhone = "";
    private string? errorMessage;
    private string? fileError;
    private bool isSubmitting = false;
    private string submitStatus = "Encrypting...";
    private List<IBrowserFile> selectedFiles = new();

    private const long MaxFileSize = 1L * 1024 * 1024 * 1024;       // 1 GB
    private const long MaxTotalSize = 5L * 1024 * 1024 * 1024;      // 5 GB
    private const long MaxFileReadSize = 1L * 1024 * 1024 * 1024;   // for ReadAsync buffer

    protected override async Task OnInitializedAsync()
    {
        try
        {
            categories = await Http.GetFromJsonAsync<List<CategoryDto>>("api/reports/categories");
        }
        catch
        {
            errorMessage = "Failed to load categories. Please refresh the page.";
        }
    }

    private void OnFilesSelected(InputFileChangeEventArgs e)
    {
        fileError = null;

        foreach (var file in e.GetMultipleFiles(20))
        {
            // Check individual file size
            if (file.Size > MaxFileSize)
            {
                fileError = $"'{file.Name}' exceeds the 1 GB file size limit.";
                continue;
            }

            // Check total size
            var currentTotal = selectedFiles.Sum(f => f.Size) + file.Size;
            if (currentTotal > MaxTotalSize)
            {
                fileError = "Total attachments would exceed the 5 GB limit.";
                break;
            }

            // Avoid duplicates
            if (!selectedFiles.Any(f => f.Name == file.Name && f.Size == file.Size))
            {
                selectedFiles.Add(file);
            }
        }
    }

    private void RemoveFile(IBrowserFile file)
    {
        selectedFiles.Remove(file);
        fileError = null;
    }

    private string FormatFileSize(long bytes)
    {
        if (bytes < 1024) return $"{bytes} B";
        if (bytes < 1024 * 1024) return $"{bytes / 1024.0:F1} KB";
        if (bytes < 1024 * 1024 * 1024) return $"{bytes / (1024.0 * 1024):F1} MB";
        return $"{bytes / (1024.0 * 1024 * 1024):F2} GB";
    }

    private async Task HandleSubmit()
    {
        // =================================================
        // WE NEED TO CREATE A HASH OF JAVASCRIPT FILE TO COMPARE TO BEFORE WE PROCEED WITH ENCRYPTION
        // - STILL TO BE IMPLEMENTED DUDU //
        //==================================================
        errorMessage = null;

        if (string.IsNullOrWhiteSpace(reportText))
        {
            errorMessage = "Please enter your report details.";
            return;
        }

        isSubmitting = true;

        try
        {
            // ==========================================================
            // STEP 1: Generate token and hash it
            // ==========================================================
            submitStatus = "Generating secure token...";
            StateHasChanged();

            var token = await Crypto.GenerateTokenAsync();
            var tokenHash = await Crypto.HashTokenAsync(token);

            // ==========================================================
            // STEP 2: Generate WB keypair
            // ==========================================================
            submitStatus = "Generating encryption keys (this may take a moment)...";
            StateHasChanged();

            var wbKeypair = await Crypto.GenerateKeypairAsync();

            // ==========================================================
            // STEP 3: Encrypt WB private key with wrapping key
            // ==========================================================
            var wbKeySalt = Convert.ToBase64String(
                System.Security.Cryptography.RandomNumberGenerator.GetBytes(16));
            var wrappingKey = await Crypto.HashTokenAsync(token);
            var encryptedWbPrivateKey = await Crypto.EncryptPrivateKeyAsync(
                wbKeypair.PrivateKey, wrappingKey);

            // ==========================================================
            // STEP 4: Fetch investigator's public key
            // ==========================================================
            submitStatus = "Fetching encryption configuration...";
            StateHasChanged();

            var publicKeyResponse = await Http.GetFromJsonAsync<PublicKeyDto>("api/config/public-key");
            if (publicKeyResponse == null)
            {
                errorMessage = "Failed to fetch investigator's public key.";
                return;
            }
            var investigatorPublicKey = publicKeyResponse.PublicKey;

            // ==========================================================
            // STEP 5: Encrypt report text
            // ==========================================================
            submitStatus = "Encrypting report...";
            StateHasChanged();

            var reportSymmetricKey = await Crypto.GenerateSymmetricKeyAsync();
            var reportTextBase64 = await Crypto.StringToBase64Async(reportText);
            var encryptedReport = await Crypto.EncryptSymmetricAsync(reportTextBase64, reportSymmetricKey);

            var reportKeyEnvelope = await Crypto.EncryptWithPublicKeyAsync(
                reportSymmetricKey, investigatorPublicKey);
            var wbReportKeyEnvelope = await Crypto.EncryptWithPublicKeyAsync(
                reportSymmetricKey, wbKeypair.PublicKey);

            // ==========================================================
            // STEP 6: Encrypt identity fields (if provided)
            // ==========================================================
            bool selfIdentified = !string.IsNullOrWhiteSpace(identityName) ||
                                  !string.IsNullOrWhiteSpace(identityEmail) ||
                                  !string.IsNullOrWhiteSpace(identityPhone);

            string? encryptedIdentityPayload = null;
            string? identityKeyEnvelopePayload = null;

            if (selfIdentified)
            {
                submitStatus = "Encrypting identity...";
                StateHasChanged();

                var identityJson = System.Text.Json.JsonSerializer.Serialize(new
                {
                    name = string.IsNullOrWhiteSpace(identityName) ? null : identityName,
                    email = string.IsNullOrWhiteSpace(identityEmail) ? null : identityEmail,
                    phone = string.IsNullOrWhiteSpace(identityPhone) ? null : identityPhone
                });

                var identityKey = await Crypto.GenerateSymmetricKeyAsync();
                var identityBase64 = await Crypto.StringToBase64Async(identityJson);
                var encryptedIdentity = await Crypto.EncryptSymmetricAsync(identityBase64, identityKey);
                var identityKeyEnvelope = await Crypto.EncryptWithPublicKeyAsync(
                    identityKey, investigatorPublicKey);

                encryptedIdentityPayload = Convert.ToBase64String(
                    System.Text.Encoding.UTF8.GetBytes(
                        System.Text.Json.JsonSerializer.Serialize(encryptedIdentity)));
                identityKeyEnvelopePayload = identityKeyEnvelope;
            }

            // ==========================================================
            // STEP 7: Encrypt file attachments
            // ==========================================================
            var encryptedAttachments = new List<object>();

            for (int i = 0; i < selectedFiles.Count; i++)
            {
                var file = selectedFiles[i];
                submitStatus = $"Encrypting file {i + 1} of {selectedFiles.Count}: {file.Name}...";
                StateHasChanged();

                // Read file content
                using var stream = file.OpenReadStream(MaxFileReadSize);
                using var memoryStream = new System.IO.MemoryStream();
                await stream.CopyToAsync(memoryStream);
                var fileContentBase64 = Convert.ToBase64String(memoryStream.ToArray());

                // Encrypt filename
                var fileNameBase64 = await Crypto.StringToBase64Async(file.Name);

                // Generate unique key for this file and encrypt
                var fileKey = await Crypto.GenerateSymmetricKeyAsync();
                var encryptedFile = await Crypto.EncryptFileAsync(fileContentBase64, fileNameBase64, fileKey);

                // Encrypt file key for both recipients
                var fileKeyEnvelope = await Crypto.EncryptWithPublicKeyAsync(fileKey, investigatorPublicKey);
                var wbFileKeyEnvelope = await Crypto.EncryptWithPublicKeyAsync(fileKey, wbKeypair.PublicKey);

                // Serialize encrypted content
                var encryptedContentBlob = Convert.ToBase64String(
                    System.Text.Encoding.UTF8.GetBytes(
                        System.Text.Json.JsonSerializer.Serialize(encryptedFile)));

                encryptedAttachments.Add(new
                {
                    encryptedContent = encryptedContentBlob,
                    encryptedKeyEnvelope = fileKeyEnvelope,
                    wbKeyEnvelope = wbFileKeyEnvelope,
                    encryptedFileName = Convert.ToBase64String(
                        System.Text.Encoding.UTF8.GetBytes(fileNameBase64)),
                    mimeType = file.ContentType,
                    fileSize = file.Size
                });
            }

            // ==========================================================
            // STEP 8: Build and send payload
            // ==========================================================
            submitStatus = "Submitting encrypted report...";
            StateHasChanged();

            var encryptedContentPayload = Convert.ToBase64String(
                System.Text.Encoding.UTF8.GetBytes(
                    System.Text.Json.JsonSerializer.Serialize(encryptedReport)));

            var payload = new
            {
                tokenHash = tokenHash,
                categoryId = string.IsNullOrEmpty(selectedCategoryId)
                    ? (int?)null
                    : int.Parse(selectedCategoryId),
                encryptedContent = encryptedContentPayload,
                encryptedKeyEnvelope = reportKeyEnvelope,
                wbKeyEnvelope = wbReportKeyEnvelope,
                wbPublicKey = wbKeypair.PublicKey,
                encryptedWbPrivateKey = Convert.ToBase64String(
                    System.Text.Encoding.UTF8.GetBytes(
                        System.Text.Json.JsonSerializer.Serialize(encryptedWbPrivateKey))),
                wbKeySalt = wbKeySalt,
                selfIdentified = selfIdentified,
                encryptedIdentity = encryptedIdentityPayload,
                encryptedIdentityKeyEnvelope = identityKeyEnvelopePayload,
                attachments = encryptedAttachments
            };

            var response = await Http.PostAsJsonAsync("api/reports", payload);

            if (response.IsSuccessStatusCode)
            {
                var result = await response.Content.ReadFromJsonAsync<SubmitResultDto>();
                Navigation.NavigateTo($"/token/{result?.CaseNumber}/{Uri.EscapeDataString(token)}");
            }
            else
            {
                var error = await response.Content.ReadAsStringAsync();
                errorMessage = $"Submission failed: {error}";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"An error occurred: {ex.Message}";
        }
        finally
        {
            isSubmitting = false;
        }
    }

    private class CategoryDto
    {
        public int CategoryId { get; set; }
        public string Name { get; set; } = "";
        public string? Description { get; set; }
    }

    private class SubmitResultDto
    {
        public string CaseNumber { get; set; } = "";
    }

    private class PublicKeyDto
    {
        public string PublicKey { get; set; } = "";
    }
}