@page "/submit"
@inject HttpClient Http
@inject NavigationManager Navigation
@inject WhistleblowerPlatform.Client.Services.CryptoService Crypto
@inject IConfiguration Configuration
@inject IJSRuntime JS
@implements IDisposable

<div class="container mt-4" style="max-width: 720px;">
    <h2 class="mb-4">Submit a Report</h2>

    <div class="alert alert-info">
        <strong>Your privacy is protected.</strong> All data is encrypted in your browser before being sent.
        The server never sees your report in plaintext.
    </div>

    @if (errorMessage != null)
    {
        <div class="alert alert-danger">@errorMessage</div>
    }

    <div class="mb-3">
        <label class="form-label">Category</label>
        <select class="form-select" @bind="selectedCategoryId">
            <option value="">-- Select a category --</option>
            @if (categories != null)
            {
                @foreach (var category in categories)
                {
                    <option value="@category.CategoryId">@category.Name</option>
                }
            }
        </select>
    </div>

    <div class="mb-3">
        <label class="form-label">Report Details <span class="text-danger">*</span></label>
        <textarea class="form-control" rows="8"
                  maxlength="5000"
                  placeholder="Describe the misconduct you wish to report..."
                  @bind="reportText" @bind:event="oninput"></textarea>
        <div class="d-flex justify-content-end mt-1">
            <small class="@(reportText.Length >= 5000 ? "text-danger" : "text-muted")">
                @reportText.Length / 5000
            </small>
        </div>
    </div>

    <div class="card mb-3">
        <div class="card-header">
            Attachments
        </div>
        <div class="card-body">
            <p class="text-muted">
                Upload supporting documents, images, or audio files.
                Max 1 GB per file, 5 GB total. Metadata (EXIF, GPS, author) will be stripped before encryption.
            </p>
            <InputFile OnChange="OnFilesSelected" multiple class="form-control" />

            @if (selectedFiles.Count > 0)
            {
                <ul class="list-group mt-3">
                    @foreach (var file in selectedFiles)
                    {
                        <li class="list-group-item d-flex justify-content-between align-items-center">
                            <span>@file.Name <small class="text-muted">(@FormatFileSize(file.Size))</small></span>
                            <button class="btn btn-sm btn-outline-danger" @onclick="() => RemoveFile(file)">Remove</button>
                        </li>
                    }
                </ul>
                <p class="text-muted mt-2 mb-0">
                    Total: @FormatFileSize(selectedFiles.Sum(f => f.Size))
                </p>
            }

            @if (fileError != null)
            {
                <div class="alert alert-danger mt-2 mb-0">@fileError</div>
            }
        </div>
    </div>

    <div class="card mb-3">
        <div class="card-header">
            Optional: Identify Yourself
        </div>
        <div class="card-body">
            <div class="alert alert-warning mb-3">
                <strong>These fields are entirely OPTIONAL.</strong> Providing your identity is voluntary.
                If provided, this information will be encrypted and only visible to the investigator.
            </div>
            <div class="mb-2">
                <label class="form-label">Name</label>
                <input type="text" class="form-control" @bind="identityName" />
            </div>
            <div class="mb-2">
                <label class="form-label">Email</label>
                <input type="email" class="form-control" @bind="identityEmail" />
            </div>
            <div class="mb-2">
                <label class="form-label">Phone</label>
                <input type="tel" class="form-control" @bind="identityPhone" />
            </div>
        </div>
    </div>

    <button class="btn btn-primary btn-lg w-100" @onclick="HandleSubmitClick" disabled="@isSubmitting">
        @if (isSubmitting)
        {
            <span class="spinner-border spinner-border-sm me-2"></span>
            <span>@submitStatus</span>
        }
        else
        {
            <span>Submit Report</span>
        }
    </button>
</div>

<!-- CAPTCHA Verification Modal -->
<div class="modal fade" id="captchaModal" tabindex="-1" aria-labelledby="captchaModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="captchaModalLabel">Verify You're Human</h5>
            </div>
            <div class="modal-body">
                <p class="text-muted mb-3">
                    Please complete this verification to prevent automated submissions.
                </p>
                
                <div class="d-flex justify-content-center">
                    <div class="h-captcha" 
                         data-sitekey="@hCaptchaSiteKey"
                         data-callback="onCaptchaSuccess"
                         data-expired-callback="onCaptchaExpired"
                         data-error-callback="onCaptchaError">
                    </div>
                </div>

                @if (!string.IsNullOrEmpty(captchaError))
                {
                    <div class="alert alert-danger mt-3 mb-0" role="alert">
                        @captchaError
                    </div>
                }
            </div>
            <div class="modal-footer">
                <button type="button" 
                        class="btn btn-secondary" 
                        @onclick="HandleCancelCaptcha"
                        disabled="@isProcessingCaptcha">
                    Cancel
                </button>
                <button type="button" 
                        class="btn btn-primary" 
                        @onclick="HandleCaptchaSubmit"
                        disabled="@(!isCaptchaSolved || isProcessingCaptcha)">
                    @if (isProcessingCaptcha)
                    {
                        <span class="spinner-border spinner-border-sm me-2"></span>
                        <span>Processing...</span>
                    }
                    else
                    {
                        <span>Continue</span>
                    }
                </button>
            </div>
        </div>
    </div>
</div>

@code {
    // Existing fields
    private List<CategoryDto>? categories;
    private string? selectedCategoryId;
    private string reportText = "";
    private string identityName = "";
    private string identityEmail = "";
    private string identityPhone = "";
    private string? errorMessage;
    private string? fileError;
    private bool isSubmitting = false;
    private string submitStatus = "Encrypting...";
    private List<IBrowserFile> selectedFiles = new();

    private const long MaxFileSize = 1L * 1024 * 1024 * 1024;       // 1 GB
    private const long MaxTotalSize = 5L * 1024 * 1024 * 1024;      // 5 GB
    private const long MaxFileReadSize = 1L * 1024 * 1024 * 1024;   // for ReadAsync buffer

    // NEW: CAPTCHA-related fields
    private string hCaptchaSiteKey = string.Empty;
    private bool isCaptchaSolved = false;
    private bool isProcessingCaptcha = false;
    private string? captchaToken = null;
    private string? captchaError = null;
    private DotNetObjectReference<SubmitReport>? dotNetHelper;

    protected override async Task OnInitializedAsync()
    {
        // NEW: Load hCaptcha site key from configuration
        hCaptchaSiteKey = Configuration["HCaptcha:SiteKey"]
            ?? throw new InvalidOperationException("HCaptcha:SiteKey not configured");

        // NEW: Create DotNet reference for JS callbacks
        dotNetHelper = DotNetObjectReference.Create(this);

        // Existing: Load categories
        try
        {
            categories = await Http.GetFromJsonAsync<List<CategoryDto>>("api/reports/categories");
        }
        catch
        {
            errorMessage = "Failed to load categories. Please refresh the page.";
        }
    }

    // NEW: Register callback for hCaptcha
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && dotNetHelper != null)
        {
            // Register the callback reference for hCaptcha
            await JS.InvokeVoidAsync("registerBlazorCaptchaCallback", dotNetHelper);
        }
    }

    // NEW: CAPTCHA callback methods
    [JSInvokable]
    public void OnCaptchaSuccess(string token)
    {
        captchaToken = token;
        isCaptchaSolved = true;
        captchaError = null;
        StateHasChanged();
    }

    [JSInvokable]
    public void OnCaptchaExpired()
    {
        captchaToken = null;
        isCaptchaSolved = false;
        captchaError = "CAPTCHA expired. Please solve it again.";
        StateHasChanged();
    }

    [JSInvokable]
    public void OnCaptchaError()
    {
        captchaToken = null;
        isCaptchaSolved = false;
        captchaError = "CAPTCHA error occurred. Please try again.";
        StateHasChanged();
    }

    // NEW: Handle submit button click → Show CAPTCHA modal
    private async Task HandleSubmitClick()
    {
        try
        {
            // Validate form BEFORE showing CAPTCHA
            if (string.IsNullOrWhiteSpace(selectedCategoryId))
            {
                errorMessage = "Please select a report category";
                return;
            }

            if (string.IsNullOrWhiteSpace(reportText))
            {
                errorMessage = "Please enter your report details.";
                return;
            }

            // Validate file sizes
            var totalSize = selectedFiles.Sum(f => f.Size);
            if (selectedFiles.Any(f => f.Size > MaxFileSize))
            {
                errorMessage = "Individual files cannot exceed 1GB";
                return;
            }
            if (totalSize > MaxTotalSize)
            {
                errorMessage = $"Total attachments cannot exceed 5GB (current: {FormatFileSize(totalSize)})";
                return;
            }

            // Form is valid → Show CAPTCHA modal
            captchaError = null;
            isCaptchaSolved = false;
            captchaToken = null;
            await JS.InvokeVoidAsync("hCaptchaInterop.showModal");
        }
        catch (Exception ex)
        {
            errorMessage = $"Error: {ex.Message}";
        }
    }

    // NEW: Handle "Continue" button in modal → Process submission
    private async Task HandleCaptchaSubmit()
    {
        if (!isCaptchaSolved || string.IsNullOrEmpty(captchaToken))
        {
            captchaError = "Please complete the CAPTCHA verification";
            return;
        }

        try
        {
            isProcessingCaptcha = true;
            isSubmitting = true;

            // Close the modal
            await JS.InvokeVoidAsync("hCaptchaInterop.hideModal");

            // Proceed with encryption and submission
            await ProcessReportSubmission();
        }
        catch (Exception ex)
        {
            errorMessage = $"Submission failed: {ex.Message}";
            isProcessingCaptcha = false;
            isSubmitting = false;
            
            // Reset CAPTCHA for retry
            await ResetCaptcha();
        }
    }

    // NEW: Handle "Cancel" button in modal
    private async Task HandleCancelCaptcha()
    {
        await JS.InvokeVoidAsync("hCaptchaInterop.hideModal");
        await ResetCaptcha();
    }

    // NEW: Reset CAPTCHA state
    private async Task ResetCaptcha()
    {
        captchaToken = null;
        isCaptchaSolved = false;
        captchaError = null;
        await JS.InvokeVoidAsync("hCaptchaInterop.reset");
    }

    // RENAMED: HandleSubmit → ProcessReportSubmission
    // This is the existing encryption logic with CAPTCHA token added
    private async Task ProcessReportSubmission()
    {
        // =================================================
        // WE NEED TO CREATE A HASH OF JAVASCRIPT FILE TO COMPARE TO BEFORE WE PROCEED WITH ENCRYPTION
        // - STILL TO BE IMPLEMENTED DUDU //
        //==================================================
        errorMessage = null;

        try
        {
            isSubmitting = true;

            // ==========================================================
            // STEP 1: Generate token
            // ==========================================================
            submitStatus = "Generating secure token...";
            StateHasChanged();

            var token = await Crypto.GenerateTokenAsync();
            var tokenHash = await Crypto.HashTokenAsync(token);

            // ==========================================================
            // STEP 2: Generate WB keypair
            // ==========================================================
            submitStatus = "Generating encryption keys...";
            StateHasChanged();

            var wbKeypair = await Crypto.GenerateKeypairAsync();
            var wbKeySalt = Convert.ToBase64String(
    System.Security.Cryptography.RandomNumberGenerator.GetBytes(16));

            // ==========================================================
            // STEP 3: Encrypt WB private key with token-derived wrapping key
            // ==========================================================
            var wrappingKey = await Crypto.HashTokenAsync(token);
            var encryptedWbPrivateKey = await Crypto.EncryptPrivateKeyAsync(
                wbKeypair.PrivateKey, wrappingKey);

            // ==========================================================
            // STEP 4: Fetch investigator's public key
            // ==========================================================
            submitStatus = "Fetching encryption configuration...";
            StateHasChanged();

            var publicKeyResponse = await Http.GetFromJsonAsync<PublicKeyDto>("api/config/public-key");
            if (publicKeyResponse == null)
            {
                errorMessage = "Failed to fetch investigator's public key.";
                return;
            }
            var investigatorPublicKey = publicKeyResponse.PublicKey;

            // ==========================================================
            // STEP 5: Encrypt report text
            // ==========================================================
            submitStatus = "Encrypting report...";
            StateHasChanged();

            var reportSymmetricKey = await Crypto.GenerateSymmetricKeyAsync();
            var reportTextBase64 = await Crypto.StringToBase64Async(reportText);
            var encryptedReport = await Crypto.EncryptSymmetricAsync(reportTextBase64, reportSymmetricKey);

            var reportKeyEnvelope = await Crypto.EncryptWithPublicKeyAsync(
                reportSymmetricKey, investigatorPublicKey);
            var wbReportKeyEnvelope = await Crypto.EncryptWithPublicKeyAsync(
                reportSymmetricKey, wbKeypair.PublicKey);

            // ==========================================================
            // STEP 6: Encrypt identity fields (if provided)
            // ==========================================================
            bool selfIdentified = !string.IsNullOrWhiteSpace(identityName) ||
                                  !string.IsNullOrWhiteSpace(identityEmail) ||
                                  !string.IsNullOrWhiteSpace(identityPhone);

            string? encryptedIdentityPayload = null;
            string? identityKeyEnvelopePayload = null;

            if (selfIdentified)
            {
                submitStatus = "Encrypting identity...";
                StateHasChanged();

                var identityJson = System.Text.Json.JsonSerializer.Serialize(new
                {
                    name = string.IsNullOrWhiteSpace(identityName) ? null : identityName,
                    email = string.IsNullOrWhiteSpace(identityEmail) ? null : identityEmail,
                    phone = string.IsNullOrWhiteSpace(identityPhone) ? null : identityPhone
                });

                var identityKey = await Crypto.GenerateSymmetricKeyAsync();
                var identityBase64 = await Crypto.StringToBase64Async(identityJson);
                var encryptedIdentity = await Crypto.EncryptSymmetricAsync(identityBase64, identityKey);
                var identityKeyEnvelope = await Crypto.EncryptWithPublicKeyAsync(
                    identityKey, investigatorPublicKey);

                encryptedIdentityPayload = Convert.ToBase64String(
                    System.Text.Encoding.UTF8.GetBytes(
                        System.Text.Json.JsonSerializer.Serialize(encryptedIdentity)));
                identityKeyEnvelopePayload = identityKeyEnvelope;
            }

            // ==========================================================
            // STEP 7: Encrypt file attachments (dual encryption — ADR-001)
            // Each file is encrypted twice:
            //   1. Sanitization key (server can decrypt to strip metadata)
            //   2. Recipient key envelopes (investigator + WB)
            // ==========================================================
            var encryptedAttachments = new List<object>();

            for (int i = 0; i < selectedFiles.Count; i++)
            {
                var file = selectedFiles[i];
                submitStatus = $"Encrypting file {i + 1} of {selectedFiles.Count}: {file.Name}...";
                StateHasChanged();

                // Read file content
                using var stream = file.OpenReadStream(MaxFileReadSize);
                using var memoryStream = new System.IO.MemoryStream();
                await stream.CopyToAsync(memoryStream);
                var fileContentBase64 = Convert.ToBase64String(memoryStream.ToArray());

                // Encrypt filename
                var fileNameBase64 = await Crypto.StringToBase64Async(file.Name);

                // Dual encryption: sanitization + recipient
                var dualEncrypted = await Crypto.EncryptFileForSanitizationAsync(
                    fileContentBase64, fileNameBase64, investigatorPublicKey, wbKeypair.PublicKey);

                // Serialize the recipient encrypted content
                var encryptedContentBlob = Convert.ToBase64String(
                    System.Text.Encoding.UTF8.GetBytes(
                        System.Text.Json.JsonSerializer.Serialize(dualEncrypted.RecipientBlob)));

                // Serialize the sanitization blob
                var sanitizationBlobSerialized = Convert.ToBase64String(
                    System.Text.Encoding.UTF8.GetBytes(
                        System.Text.Json.JsonSerializer.Serialize(dualEncrypted.SanitizationBlob)));

                encryptedAttachments.Add(new
                {
                    // Sanitization data (server can decrypt to strip metadata)
                    sanitizationBlob = sanitizationBlobSerialized,
                    sanitizationKey = dualEncrypted.SanitizationKey,

                    // Recipient data (investigator + WB can decrypt)
                    encryptedContent = encryptedContentBlob,
                    encryptedKeyEnvelope = dualEncrypted.KeyEnvelope,
                    wbKeyEnvelope = dualEncrypted.WbKeyEnvelope,
                    encryptedFileName = Convert.ToBase64String(
                        System.Text.Encoding.UTF8.GetBytes(fileNameBase64)),
                    mimeType = file.ContentType,
                    fileSize = file.Size
                });
            }

            // ==========================================================
            // STEP 8: Build and send payload (WITH CAPTCHA TOKEN)
            // ==========================================================
            submitStatus = "Submitting encrypted report...";
            StateHasChanged();

            var encryptedContentPayload = Convert.ToBase64String(
                System.Text.Encoding.UTF8.GetBytes(
                    System.Text.Json.JsonSerializer.Serialize(encryptedReport)));

            var payload = new
            {
                tokenHash = tokenHash,
                categoryId = string.IsNullOrEmpty(selectedCategoryId)
                    ? (int?)null
                    : int.Parse(selectedCategoryId),
                encryptedContent = encryptedContentPayload,
                encryptedKeyEnvelope = reportKeyEnvelope,
                wbKeyEnvelope = wbReportKeyEnvelope,
                wbPublicKey = wbKeypair.PublicKey,
                encryptedWbPrivateKey = Convert.ToBase64String(
                    System.Text.Encoding.UTF8.GetBytes(
                        System.Text.Json.JsonSerializer.Serialize(encryptedWbPrivateKey))),
                wbKeySalt = wbKeySalt,
                selfIdentified = selfIdentified,
                encryptedIdentity = encryptedIdentityPayload,
                encryptedIdentityKeyEnvelope = identityKeyEnvelopePayload,
                attachments = encryptedAttachments,
                hCaptchaToken = captchaToken  // NEW: Add CAPTCHA token
            };

            var response = await Http.PostAsJsonAsync("api/reports", payload);

            if (response.IsSuccessStatusCode)
            {
                var result = await response.Content.ReadFromJsonAsync<SubmitResultDto>();
                
                // Reset CAPTCHA before navigation
                await ResetCaptcha();
                
                Navigation.NavigateTo($"/token/{result?.CaseNumber}/{Uri.EscapeDataString(token)}");
            }
            else
            {
                var error = await response.Content.ReadAsStringAsync();
                errorMessage = $"Submission failed: {error}";
                
                // Reset CAPTCHA for retry
                await ResetCaptcha();
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"An error occurred: {ex.Message}";
            
            // Reset CAPTCHA for retry
            await ResetCaptcha();
        }
        finally
        {
            isSubmitting = false;
            isProcessingCaptcha = false;
        }
    }

    // Existing helper methods (unchanged)
    private void OnFilesSelected(InputFileChangeEventArgs e)
    {
        fileError = null;

        foreach (var file in e.GetMultipleFiles(20))
        {
            // Check individual file size
            if (file.Size > MaxFileSize)
            {
                fileError = $"'{file.Name}' exceeds the 1 GB file size limit.";
                continue;
            }

            // Check total size
            var currentTotal = selectedFiles.Sum(f => f.Size) + file.Size;
            if (currentTotal > MaxTotalSize)
            {
                fileError = "Total attachments would exceed the 5 GB limit.";
                break;
            }

            // Avoid duplicates
            if (!selectedFiles.Any(f => f.Name == file.Name && f.Size == file.Size))
            {
                selectedFiles.Add(file);
            }
        }
    }

    private void RemoveFile(IBrowserFile file)
    {
        selectedFiles.Remove(file);
        fileError = null;
    }

    private string FormatFileSize(long bytes)
    {
        if (bytes < 1024) return $"{bytes} B";
        if (bytes < 1024 * 1024) return $"{bytes / 1024.0:F1} KB";
        if (bytes < 1024 * 1024 * 1024) return $"{bytes / (1024.0 * 1024):F1} MB";
        return $"{bytes / (1024.0 * 1024 * 1024):F2} GB";
    }

    // NEW: Dispose method
    public void Dispose()
    {
        dotNetHelper?.Dispose();
    }

    // DTOs (unchanged)
    private class CategoryDto
    {
        public int CategoryId { get; set; }
        public string Name { get; set; } = "";
        public string? Description { get; set; }
    }

    private class SubmitResultDto
    {
        public string CaseNumber { get; set; } = "";
    }

    private class PublicKeyDto
    {
        public string PublicKey { get; set; } = "";
    }
}
