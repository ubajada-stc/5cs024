@page "/admin/settings"
@using WhistleblowerPlatform.Client.Services
@inject AuthService AuthService
@inject AdminService AdminService
@inject NavigationManager Navigation

@code {
    private List<SettingItem> _settings = new();
    private bool _loading = true;
    private string _error = "";

    // Track edited values and save state per key
    private Dictionary<string, string> _editValues = new();
    private HashSet<string> _saving = new();
    private HashSet<string> _saved = new();

    protected override async Task OnInitializedAsync()
    {
        if (AuthService.AccessToken == null || AuthService.Role != "Admin")
        {
            Navigation.NavigateTo("/login");
            return;
        }
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _settings = await AdminService.GetSettingsAsync();
        _editValues = _settings.ToDictionary(s => s.SettingKey, s => s.SettingValue);
        _loading = false;
    }

    private async Task Save(string key)
    {
        _error = "";
        _saving.Add(key);
        _saved.Remove(key);
        var ok = await AdminService.UpdateSettingAsync(key, _editValues[key]);
        _saving.Remove(key);
        if (!ok) { _error = $"Failed to save {key}."; return; }
        _saved.Add(key);
        var setting = _settings.FirstOrDefault(s => s.SettingKey == key);
        if (setting != null) { setting.SettingValue = _editValues[key]; setting.UpdatedAt = DateTime.UtcNow; }
    }
}

<div class="hero-section">
    <div style="max-width: 900px; margin: 0 auto;">

        <!-- Header -->
        <div class="d-flex align-items-start justify-content-between mb-5">
            <div>
                <h1>Platform Settings</h1>
                <p class="lead" style="margin: 0;">Changes take effect immediately or on the next background service cycle</p>
            </div>
            <a href="admin/dashboard" class="btn btn-outline-secondary btn-sm" style="white-space: nowrap;">&larr; Back to Dashboard</a>
        </div>

        @if (!string.IsNullOrEmpty(_error))
        {
            <div class="alert alert-danger mb-4">@_error</div>
        }

        @if (_loading)
        {
            <div class="text-center" style="color: var(--color-muted-fg); padding: 3rem 0;">
                <span class="spinner-border spinner-border-sm me-2"></span> Loading...
            </div>
        }
        else if (!_settings.Any())
        {
            <div class="alert alert-warning">
                No settings found. Run the seed script in <code>db/005_seed_platform_settings.sql</code> to populate defaults.
            </div>
        }
        else
        {
            <div style="display: flex; flex-direction: column; gap: 2rem;">
                @foreach (var setting in _settings)
                {
                    <div style="background: rgba(255,255,255,0.85); backdrop-filter: blur(8px); border: 1px solid var(--color-border); border-radius: var(--radius-xl); padding: 3rem; box-shadow: 0 2rem 6rem rgba(0,0,0,0.08);">
                        <div class="row g-4 align-items-start">
                            <div class="col-md">
                                <h3 style="font-size: 1.1rem; font-weight: 600; margin-bottom: 0.6rem;">@setting.SettingKey</h3>
                                @if (!string.IsNullOrEmpty(setting.Description))
                                {
                                    <p style="font-size: 0.9rem; color: var(--color-muted-fg); line-height: 1.7; margin-bottom: 0.6rem;">@setting.Description</p>
                                }
                                <p style="font-size: 0.8rem; color: var(--color-muted-fg); margin: 0;">
                                    Last updated: @setting.UpdatedAt.ToString("yyyy-MM-dd HH:mm")
                                </p>
                            </div>
                            <div class="col-md-auto" style="min-width: 220px;">
                                <input type="number" class="form-control mb-2"
                                       value="@_editValues[setting.SettingKey]"
                                       @oninput="e => _editValues[setting.SettingKey] = e.Value?.ToString() ?? string.Empty"
                                       disabled="@_saving.Contains(setting.SettingKey)" />
                                <button class="btn btn-primary w-100"
                                        style="border-radius: var(--radius-lg);"
                                        @onclick="() => Save(setting.SettingKey)"
                                        disabled="@_saving.Contains(setting.SettingKey)">
                                    @if (_saving.Contains(setting.SettingKey))
                                    {
                                        <span class="spinner-border spinner-border-sm me-1"></span>
                                    }
                                    @(_saving.Contains(setting.SettingKey) ? "Saving..." : "Save")
                                </button>
                                @if (_saved.Contains(setting.SettingKey))
                                {
                                    <div style="font-size: 0.8rem; color: #10b981; margin-top: 0.4rem; text-align: center;">
                                        ✓ Saved
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                }
            </div>
        }

    </div>
</div>
