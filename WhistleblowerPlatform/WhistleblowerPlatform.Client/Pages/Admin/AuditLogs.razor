@page "/admin/audit-logs"
@using WhistleblowerPlatform.Client.Services
@inject AuthService AuthService
@inject AdminService AdminService
@inject NavigationManager Navigation

@code {
    private AuditLogPage _result = new();
    private bool _loading = true;
    private string _error = "";

    // Filters
    private string _actorTypeFilter = "";
    private string _actionFilter = "";
    private DateTime? _fromFilter;
    private DateTime? _toFilter;
    private int _page = 1;
    private const int PageSize = 50;

    private static readonly Dictionary<byte, string> ActorLabels = new()
    {
        { 0, "Whistleblower" },
        { 1, "Investigator" },
        { 2, "Admin" },
        { 3, "System" }
    };

    protected override async Task OnInitializedAsync()
    {
        if (AuthService.AccessToken == null || AuthService.Role != "Admin")
        {
            Navigation.NavigateTo("/login");
            return;
        }
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _error = "";
        byte? actorType = byte.TryParse(_actorTypeFilter, out var b) ? b : null;
        _result = await AdminService.GetAuditLogsAsync(actorType, _actionFilter, _fromFilter, _toFilter, _page, PageSize);
        _loading = false;
    }

    private async Task ApplyFilters()
    {
        _page = 1;
        await LoadAsync();
    }

    private async Task GoToPage(int p)
    {
        _page = p;
        await LoadAsync();
    }

    private int TotalPages => (int)Math.Ceiling((double)_result.Total / PageSize);

    private string ActorLabel(byte actorType) =>
        ActorLabels.TryGetValue(actorType, out var label) ? label : actorType.ToString();
}

<div class="hero-section">
    <div style="max-width: 1200px; margin: 0 auto;">

        <!-- Header -->
        <div class="d-flex align-items-start justify-content-between mb-5">
            <div>
                <h1>Audit Logs</h1>
                <p class="lead" style="margin: 0;">View platform activity for compliance and security</p>
            </div>
            <a href="admin/dashboard" class="btn btn-outline-secondary btn-sm" style="white-space: nowrap;">
                &larr; Back to Dashboard
            </a>
        </div>

        @if (!string.IsNullOrEmpty(_error))
        {
            <div class="alert alert-danger mb-4">@_error</div>
        }

        <!-- Main card -->
        <div style="background: rgba(255,255,255,0.85); backdrop-filter: blur(8px); border: 1px solid var(--color-border); border-radius: var(--radius-xl); box-shadow: 0 2rem 6rem rgba(0,0,0,0.08); overflow: hidden;">

            <!-- Toolbar -->
            <div style="padding: 2rem 2.5rem; border-bottom: 1px solid var(--color-border);">
                <div class="d-flex align-items-center justify-content-between gap-3 flex-wrap">
                    <div class="d-flex align-items-center gap-3 flex-wrap flex-grow-1">
                        <input type="text" placeholder="Search by action..."
                               style="background-color: var(--color-muted-bg); border: none; border-radius: var(--radius-lg); padding: 0.75rem 1rem; font-size: 0.9rem; width: 22rem; outline: none;"
                               @bind="_actionFilter" @bind:event="oninput" />
                        <select style="background-color: var(--color-muted-bg); border: none; border-radius: var(--radius-lg); padding: 0.75rem 1rem; font-size: 0.9rem; color: var(--color-foreground); outline: none;"
                                @bind="_actorTypeFilter">
                            <option value="">All actors</option>
                            <option value="0">Whistleblower</option>
                            <option value="1">Investigator</option>
                            <option value="2">Admin</option>
                            <option value="3">System</option>
                        </select>
                        <input type="date" style="background-color: var(--color-muted-bg); border: none; border-radius: var(--radius-lg); padding: 0.75rem 1rem; font-size: 0.9rem; color: var(--color-foreground); outline: none;"
                               @bind="_fromFilter" @bind:event="oninput" />
                        <input type="date" style="background-color: var(--color-muted-bg); border: none; border-radius: var(--radius-lg); padding: 0.75rem 1rem; font-size: 0.9rem; color: var(--color-foreground); outline: none;"
                               @bind="_toFilter" @bind:event="oninput" />
                        <button class="btn btn-primary" style="border-radius: var(--radius-lg); padding: 0.75rem 1.75rem; font-size: 0.9rem;"
                                @onclick="ApplyFilters">Filter</button>
                    </div>
                </div>
            </div>

            <!-- Table -->
            @if (_loading)
            {
                <div style="padding: 3rem; text-align: center; color: var(--color-muted-fg);">
                    <span class="spinner-border spinner-border-sm me-2"></span> Loading...
                </div>
            }
            else
            {
                <div style="overflow-x: auto;">
                    <table class="table mb-0" style="min-width: 900px;">
                        <thead>
                            <tr style="background-color: rgba(var(--color-primary-rgb), 0.04); border-bottom: 1px solid var(--color-border);">
                                <th style="padding: 1rem 1.5rem; font-size: 0.8rem; font-weight: 600; color: var(--color-muted-fg); text-transform: uppercase; letter-spacing: 0.05em;">Timestamp</th>
                                <th style="padding: 1rem 1.5rem; font-size: 0.8rem; font-weight: 600; color: var(--color-muted-fg); text-transform: uppercase; letter-spacing: 0.05em;">Actor</th>
                                <th style="padding: 1rem 1.5rem; font-size: 0.8rem; font-weight: 600; color: var(--color-muted-fg); text-transform: uppercase; letter-spacing: 0.05em;">Action</th>
                                <th style="padding: 1rem 1.5rem; font-size: 0.8rem; font-weight: 600; color: var(--color-muted-fg); text-transform: uppercase; letter-spacing: 0.05em;">Target</th>
                                <th style="padding: 1rem 1.5rem; font-size: 0.8rem; font-weight: 600; color: var(--color-muted-fg); text-transform: uppercase; letter-spacing: 0.05em;">Detail</th>
                                <th style="padding: 1rem 1.5rem; font-size: 0.8rem; font-weight: 600; color: var(--color-muted-fg); text-transform: uppercase; letter-spacing: 0.05em;">IP Address</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var log in _result.Logs)
                            {
                                <tr style="border-bottom: 1px solid var(--color-border); transition: background-color 0.1s ease;" onmouseover="this.style.backgroundColor='rgba(0,0,0,0.02)'" onmouseout="this.style.backgroundColor=''">
                                    <td style="padding: 1rem 1.5rem; font-size: 0.875rem; font-family: monospace; white-space: nowrap;">@log.Timestamp.ToString("yyyy-MM-dd HH:mm:ss")</td>
                                    <td style="padding: 1rem 1.5rem; font-size: 0.875rem;">@ActorLabel(log.ActorType)</td>
                                    <td style="padding: 1rem 1.5rem; font-size: 0.875rem;">@log.Action</td>
                                    <td style="padding: 1rem 1.5rem; font-size: 0.875rem;">
                                        @if (!string.IsNullOrEmpty(log.TargetEntity))
                                        {
                                            <span>@log.TargetEntity</span>
                                            @if (!string.IsNullOrEmpty(log.TargetId))
                                            {
                                                <span style="color: var(--color-muted-fg);"> / @log.TargetId.Substring(0, Math.Min(8, log.TargetId.Length))&hellip;</span>
                                            }
                                        }
                                    </td>
                                    <td style="padding: 1rem 1.5rem; font-size: 0.875rem; color: var(--color-muted-fg); max-width: 280px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;" title="@log.Detail">@log.Detail</td>
                                    <td style="padding: 1rem 1.5rem; font-size: 0.875rem; color: var(--color-muted-fg); font-family: monospace;">@log.Ipaddress</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <!-- Pagination footer -->
                <div style="padding: 1.5rem 2.5rem; border-top: 1px solid var(--color-border); background-color: rgba(var(--color-primary-rgb), 0.02); display: flex; align-items: center; justify-content: space-between;">
                    <span style="font-size: 0.875rem; color: var(--color-muted-fg);">
                        Showing @((_page - 1) * PageSize + 1)–@(Math.Min(_page * PageSize, _result.Total)) of @_result.Total entries
                    </span>
                    @if (TotalPages > 1)
                    {
                        <div class="d-flex align-items-center gap-2">
                            <button style="padding: 0.5rem 1rem; border-radius: var(--radius); border: 1px solid var(--color-border); background: transparent; font-size: 0.875rem; cursor: pointer; color: var(--color-muted-fg);"
                                    @onclick="() => GoToPage(_page - 1)" disabled="@(_page == 1)">
                                Previous
                            </button>
                            @for (var p = 1; p <= TotalPages; p++)
                            {
                                var pg = p;
                                <button style="padding: 0.5rem 1rem; border-radius: var(--radius); border: 1px solid var(--color-border); font-size: 0.875rem; cursor: pointer; background-color: @(_page == pg ? "var(--color-primary)" : "transparent"); color: @(_page == pg ? "#fff" : "var(--color-muted-fg)");"
                                        @onclick="() => GoToPage(pg)">
                                    @pg
                                </button>
                            }
                            <button style="padding: 0.5rem 1rem; border-radius: var(--radius); border: 1px solid var(--color-border); background: transparent; font-size: 0.875rem; cursor: pointer; color: var(--color-muted-fg);"
                                    @onclick="() => GoToPage(_page + 1)" disabled="@(_page == TotalPages)">
                                Next
                            </button>
                        </div>
                    }
                </div>
            }
        </div>

    </div>
</div>
