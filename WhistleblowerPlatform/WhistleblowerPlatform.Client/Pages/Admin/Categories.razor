@page "/admin/categories"
@using WhistleblowerPlatform.Client.Services
@inject AuthService AuthService
@inject AdminService AdminService
@inject NavigationManager Navigation

@code {
    private List<CategoryListItem> _categories = new();
    private bool _loading = true;
    private string _error = "";

    // New category form
    private bool _showForm = false;
    private string _newName = "";
    private string _newDescription = "";
    private int _newDisplayOrder = 1;
    private bool _saving = false;
    private string _formError = "";

    // Inline edit state
    private int? _editingId = null;
    private string _editName = "";
    private string _editDescription = "";
    private int _editDisplayOrder = 1;

    protected override async Task OnInitializedAsync()
    {
        if (AuthService.AccessToken == null || AuthService.Role != "Admin")
        {
            Navigation.NavigateTo("/login");
            return;
        }
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _error = "";
        _categories = await AdminService.GetCategoriesAsync();
        _loading = false;
    }

    private async Task CreateCategory()
    {
        _formError = "";
        _saving = true;
        var ok = await AdminService.CreateCategoryAsync(_newName, _newDescription, _newDisplayOrder);
        _saving = false;
        if (!ok) { _formError = "Failed to create category."; return; }
        _newName = ""; _newDescription = ""; _newDisplayOrder = 1; _showForm = false;
        await LoadAsync();
    }

    private void StartEdit(CategoryListItem c)
    {
        _editingId = c.CategoryId;
        _editName = c.Name;
        _editDescription = c.Description ?? "";
        _editDisplayOrder = c.DisplayOrder;
    }

    private async Task SaveEdit(int id)
    {
        var ok = await AdminService.UpdateCategoryAsync(id, _editName, _editDescription, _editDisplayOrder);
        if (!ok) { _error = "Failed to update category."; return; }
        _editingId = null;
        await LoadAsync();
    }

    private async Task Deactivate(int id)
    {
        var ok = await AdminService.DeactivateCategoryAsync(id);
        if (!ok) _error = "Failed to deactivate category.";
        else await LoadAsync();
    }
}

<div class="hero-section">
    <div style="max-width: 1100px; margin: 0 auto;">

        <!-- Header -->
        <div class="d-flex align-items-start justify-content-between mb-5">
            <div>
                <h1>Report Categories</h1>
                <p class="lead" style="margin: 0;">Configure the categories available to whistleblowers</p>
            </div>
            <div class="d-flex gap-3 align-items-center">
                <a href="admin/dashboard" class="btn btn-outline-secondary btn-sm" style="white-space: nowrap;">&larr; Back to Dashboard</a>
                <button class="btn btn-primary btn-sm px-3" @onclick="() => _showForm = !_showForm">
                    @(_showForm ? "Cancel" : "+ New Category")
                </button>
            </div>
        </div>

        @if (!string.IsNullOrEmpty(_error))
        {
            <div class="alert alert-danger mb-4">@_error</div>
        }

        <!-- New category form -->
        @if (_showForm)
        {
            <div class="submit-form-card mb-4">
                <div style="font-size: 0.8rem; color: var(--color-muted-fg); text-transform: uppercase; letter-spacing: 0.05em; margin-bottom: 1.25rem;">New Category</div>
                <div class="row g-3">
                    <div class="col-md-1">
                        <label class="form-label" style="font-size: 0.85rem;">Order</label>
                        <input type="number" class="form-control" @bind="_newDisplayOrder" disabled="@_saving" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label" style="font-size: 0.85rem;">Name</label>
                        <input type="text" class="form-control" placeholder="Category name"
                               @bind="_newName" @bind:event="oninput" disabled="@_saving" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label" style="font-size: 0.85rem;">Description <span style="color: var(--color-muted-fg); font-weight: 400;">(optional)</span></label>
                        <input type="text" class="form-control" placeholder="Brief description"
                               @bind="_newDescription" @bind:event="oninput" disabled="@_saving" />
                    </div>
                    <div class="col-md-2 d-flex align-items-end">
                        <button class="btn btn-submit w-100"
                                @onclick="CreateCategory"
                                disabled="@(_saving || string.IsNullOrWhiteSpace(_newName))">
                            @if (_saving)
                            {
                                <span class="spinner-border spinner-border-sm me-1"></span>
                            }
                            @(_saving ? "Saving..." : "Create")
                        </button>
                    </div>
                </div>
                @if (!string.IsNullOrEmpty(_formError))
                {
                    <div class="alert alert-danger mt-3 mb-0">@_formError</div>
                }
            </div>
        }

        <!-- Table card -->
        <div style="background: rgba(255,255,255,0.85); backdrop-filter: blur(8px); border: 1px solid var(--color-border); border-radius: var(--radius-xl); box-shadow: 0 2rem 6rem rgba(0,0,0,0.08); overflow: hidden;">

            @if (_loading)
            {
                <div style="padding: 3rem; text-align: center; color: var(--color-muted-fg);">
                    <span class="spinner-border spinner-border-sm me-2"></span> Loading...
                </div>
            }
            else
            {
                <div style="overflow-x: auto;">
                    <table class="table mb-0">
                        <thead>
                            <tr style="background-color: rgba(var(--color-primary-rgb), 0.04); border-bottom: 1px solid var(--color-border);">
                                <th style="padding: 1rem 1.5rem; font-size: 0.8rem; font-weight: 600; color: var(--color-muted-fg); text-transform: uppercase; letter-spacing: 0.05em; width: 5rem;">Order</th>
                                <th style="padding: 1rem 1.5rem; font-size: 0.8rem; font-weight: 600; color: var(--color-muted-fg); text-transform: uppercase; letter-spacing: 0.05em; width: 16rem;">Name</th>
                                <th style="padding: 1rem 1.5rem; font-size: 0.8rem; font-weight: 600; color: var(--color-muted-fg); text-transform: uppercase; letter-spacing: 0.05em;">Description</th>
                                <th style="padding: 1rem 1.5rem; font-size: 0.8rem; font-weight: 600; color: var(--color-muted-fg); text-transform: uppercase; letter-spacing: 0.05em; width: 10rem;">Status</th>
                                <th style="padding: 1rem 1.5rem; font-size: 0.8rem; font-weight: 600; color: var(--color-muted-fg); text-transform: uppercase; letter-spacing: 0.05em; width: 18rem;">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var cat in _categories)
                            {
                                <tr style="border-bottom: 1px solid var(--color-border);" onmouseover="this.style.backgroundColor='rgba(0,0,0,0.02)'" onmouseout="this.style.backgroundColor=''">
                                    @if (_editingId == cat.CategoryId)
                                    {
                                        <td style="padding: 0.75rem 1.5rem;">
                                            <input type="number" class="form-control form-control-sm" @bind="_editDisplayOrder" style="width: 70px;" />
                                        </td>
                                        <td style="padding: 0.75rem 1.5rem;">
                                            <input type="text" class="form-control form-control-sm" @bind="_editName" @bind:event="oninput" />
                                        </td>
                                        <td style="padding: 0.75rem 1.5rem;">
                                            <input type="text" class="form-control form-control-sm" @bind="_editDescription" @bind:event="oninput" />
                                        </td>
                                        <td style="padding: 0.75rem 1.5rem;"></td>
                                        <td style="padding: 0.75rem 1.5rem;">
                                            <div class="d-flex gap-2">
                                                <button style="padding: 0.5rem 1.25rem; border: 1px solid var(--color-border); border-radius: var(--radius); background: var(--color-primary); color: #fff; font-size: 0.875rem; cursor: pointer;"
                                                        @onclick="() => SaveEdit(cat.CategoryId)"
                                                        disabled="@string.IsNullOrWhiteSpace(_editName)">Save</button>
                                                <button style="padding: 0.5rem 1.25rem; border: 1px solid var(--color-border); border-radius: var(--radius); background: transparent; font-size: 0.875rem; cursor: pointer; color: var(--color-muted-fg);"
                                                        @onclick="() => _editingId = null">Cancel</button>
                                            </div>
                                        </td>
                                    }
                                    else
                                    {
                                        <td style="padding: 1rem 1.5rem; font-size: 0.875rem; color: var(--color-muted-fg);">@cat.DisplayOrder</td>
                                        <td style="padding: 1rem 1.5rem; font-size: 0.875rem; font-weight: 500;">@cat.Name</td>
                                        <td style="padding: 1rem 1.5rem; font-size: 0.875rem; color: var(--color-muted-fg);">@cat.Description</td>
                                        <td style="padding: 1rem 1.5rem;">
                                            @if (cat.IsActive)
                                            {
                                                <span style="display: inline-flex; padding: 0.35rem 0.85rem; background-color: var(--color-accent); color: var(--color-foreground); border-radius: var(--radius); font-size: 0.8rem; font-weight: 500;">Active</span>
                                            }
                                            else
                                            {
                                                <span style="display: inline-flex; padding: 0.35rem 0.85rem; background-color: var(--color-muted-bg); color: var(--color-muted-fg); border-radius: var(--radius); font-size: 0.8rem; font-weight: 500;">Inactive</span>
                                            }
                                        </td>
                                        <td style="padding: 1rem 1.5rem;">
                                            <div class="d-flex gap-2">
                                                <button style="padding: 0.5rem 1.25rem; border: 1px solid var(--color-border); border-radius: var(--radius); background: transparent; font-size: 0.875rem; cursor: pointer; color: var(--color-foreground);"
                                                        @onclick="() => StartEdit(cat)">Edit</button>
                                                @if (cat.IsActive)
                                                {
                                                    <button style="padding: 0.5rem 1.25rem; border: 1px solid rgba(229,62,62,0.3); border-radius: var(--radius); background: transparent; font-size: 0.875rem; cursor: pointer; color: var(--color-destructive);"
                                                            @onclick="() => Deactivate(cat.CategoryId)">Deactivate</button>
                                                }
                                            </div>
                                        </td>
                                    }
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>

    </div>
</div>
