@page "/admin/dashboard"
@using WhistleblowerPlatform.Client.Services
@inject AuthService AuthService
@inject AdminService AdminService
@inject NavigationManager Navigation

@code {
    private AdminStatsDto? _stats;
    private bool _statsLoading = true;

    protected override async Task OnInitializedAsync()
    {
        if (AuthService.AccessToken == null || AuthService.Role != "Admin")
        {
            Navigation.NavigateTo("/login");
            return;
        }
        _stats = await AdminService.GetStatsAsync();
        _statsLoading = false;
    }
}

<div class="hero-section">
    <div style="max-width: 1100px; margin: 0 auto;">

        <!-- Header -->
        <div class="mb-5">
            <h1>Admin Dashboard</h1>
            <p class="lead" style="margin: 0;">System administration and platform management</p>
        </div>

        <!-- Nav cards 2-column grid (CSS Grid ensures all 5 cards are equal height) -->
        <div class="admin-card-grid mb-4">
                <a href="admin/investigators" class="portal-card d-flex flex-column">
                    <div class="portal-card-icon">
                        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"></path>
                            <circle cx="9" cy="7" r="4"></circle>
                            <polyline points="16 11 18 13 22 9"></polyline>
                        </svg>
                    </div>
                    <h2>Investigators</h2>
                    <p>Create, update, and deactivate investigator accounts.</p>
                    <div class="portal-card-link mt-auto">Manage Investigators <span>→</span></div>
                </a>
                <a href="admin/categories" class="portal-card d-flex flex-column">
                    <div class="portal-card-icon">
                        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <line x1="8" y1="6" x2="21" y2="6"></line>
                            <line x1="8" y1="12" x2="21" y2="12"></line>
                            <line x1="8" y1="18" x2="21" y2="18"></line>
                            <line x1="3" y1="6" x2="3.01" y2="6"></line>
                            <line x1="3" y1="12" x2="3.01" y2="12"></line>
                            <line x1="3" y1="18" x2="3.01" y2="18"></line>
                        </svg>
                    </div>
                    <h2>Report Categories</h2>
                    <p>Configure the categories available to whistleblowers.</p>
                    <div class="portal-card-link mt-auto">Manage Categories <span>→</span></div>
                </a>
                <a href="admin/audit-logs" class="portal-card d-flex flex-column">
                    <div class="portal-card-icon">
                        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                            <polyline points="14 2 14 8 20 8"></polyline>
                            <line x1="16" y1="13" x2="8" y2="13"></line>
                            <line x1="16" y1="17" x2="8" y2="17"></line>
                        </svg>
                    </div>
                    <h2>Audit Logs</h2>
                    <p>View platform activity for compliance and security monitoring.</p>
                    <div class="portal-card-link mt-auto">View Audit Logs <span>→</span></div>
                </a>
                <a href="admin/settings" class="portal-card d-flex flex-column">
                    <div class="portal-card-icon">
                        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <circle cx="12" cy="12" r="3"></circle>
                            <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83-2.83l.06-.06A1.65 1.65 0 0 0 4.68 15a1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 2.83-2.83l.06.06A1.65 1.65 0 0 0 9 4.68a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 2.83l-.06.06A1.65 1.65 0 0 0 19.4 9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"></path>
                        </svg>
                    </div>
                    <h2>Platform Settings</h2>
                    <p>Configure retention, deadlines, and platform options.</p>
                    <div class="portal-card-link mt-auto">Manage Settings <span>→</span></div>
                </a>
                <a href="account/mfa" class="portal-card d-flex flex-column">
                    <div class="portal-card-icon">
                        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <rect x="3" y="11" width="18" height="11" rx="2"></rect>
                            <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
                        </svg>
                    </div>
                    <h2>Two-Factor Authentication</h2>
                    <p>Enable or disable MFA on your administrator account.</p>
                    <div class="portal-card-link mt-auto">Manage MFA <span>→</span></div>
                </a>
        </div>

        <!-- System Overview panel -->
        <div class="features-panel">
            <h3 class="mb-4" style="font-size: 1.25rem;">System Overview</h3>

            <!-- Stats row -->
            <div class="row g-4 text-center mb-4">
                @if (_statsLoading)
                {
                    <div class="col-12 text-center" style="color: var(--color-muted-fg); padding: 1rem 0;">
                        <span class="spinner-border spinner-border-sm"></span>
                    </div>
                }
                else
                {
                    <div class="col-6 col-md-3">
                        <div style="font-size: 2.5rem; font-weight: 700; color: var(--color-primary); line-height: 1;">@(_stats?.TotalReports ?? 0)</div>
                        <div style="font-size: 0.875rem; color: var(--color-muted-fg); margin-top: 0.4rem;">Total Reports</div>
                    </div>
                    <div class="col-6 col-md-3">
                        <div style="font-size: 2.5rem; font-weight: 700; color: var(--color-primary); line-height: 1;">@(_stats?.ActiveCases ?? 0)</div>
                        <div style="font-size: 0.875rem; color: var(--color-muted-fg); margin-top: 0.4rem;">Active Cases</div>
                    </div>
                    <div class="col-6 col-md-3">
                        <div style="font-size: 2.5rem; font-weight: 700; color: var(--color-primary); line-height: 1;">@(_stats?.Investigators ?? 0)</div>
                        <div style="font-size: 0.875rem; color: var(--color-muted-fg); margin-top: 0.4rem;">Investigators</div>
                    </div>
                    <div class="col-6 col-md-3">
                        <div style="font-size: 2.5rem; font-weight: 700; color: var(--color-primary); line-height: 1;">@(_stats?.FilesSanitized ?? 0)</div>
                        <div style="font-size: 0.875rem; color: var(--color-muted-fg); margin-top: 0.4rem;">Files Sanitized</div>
                    </div>
                }
            </div>

            <!-- Info tiles row -->
            <div class="row g-3">
                <div class="col-md-6 col-lg-3">
                    <div style="background-color: var(--color-muted-bg); border-radius: var(--radius-lg); padding: 1.5rem;">
                        <div style="font-weight: 600; margin-bottom: 0.5rem; font-size: 0.95rem;">Auto-Close Policy</div>
                        <div style="font-size: 0.875rem; color: var(--color-muted-fg); margin-bottom: 0.35rem;">Status: <span style="color: #10b981; font-weight: 500;">Active</span></div>
                        <div style="font-size: 0.825rem; color: var(--color-muted-fg); line-height: 1.6;">Cases automatically close after 3 months of inactivity</div>
                    </div>
                </div>
                <div class="col-md-6 col-lg-3">
                    <div style="background-color: var(--color-muted-bg); border-radius: var(--radius-lg); padding: 1.5rem;">
                        <div style="font-weight: 600; margin-bottom: 0.5rem; font-size: 0.95rem;">File Sanitization</div>
                        <div style="font-size: 0.875rem; color: var(--color-muted-fg); margin-bottom: 0.35rem;">Status: <span style="color: #10b981; font-weight: 500;">Enabled</span></div>
                        <div style="font-size: 0.825rem; color: var(--color-muted-fg); line-height: 1.6;">Automatic metadata removal from all uploaded files</div>
                    </div>
                </div>
                <div class="col-md-6 col-lg-3">
                    <div style="background-color: var(--color-muted-bg); border-radius: var(--radius-lg); padding: 1.5rem;">
                        <div style="font-weight: 600; margin-bottom: 0.5rem; font-size: 0.95rem;">Encryption</div>
                        <div style="font-size: 0.875rem; color: var(--color-muted-fg); margin-bottom: 0.35rem;">Protocol: <span style="color: var(--color-foreground); font-weight: 500;">AES-256</span></div>
                        <div style="font-size: 0.825rem; color: var(--color-muted-fg); line-height: 1.6;">End-to-end encryption for all stored data</div>
                    </div>
                </div>
                <div class="col-md-6 col-lg-3">
                    <div style="background-color: var(--color-muted-bg); border-radius: var(--radius-lg); padding: 1.5rem;">
                        <div style="font-weight: 600; margin-bottom: 0.5rem; font-size: 0.95rem;">Security Status</div>
                        <div style="font-size: 0.875rem; color: var(--color-muted-fg); margin-bottom: 0.35rem;">System: <span style="color: #10b981; font-weight: 500;">Operational</span></div>
                        <div style="font-size: 0.825rem; color: var(--color-muted-fg); line-height: 1.6;">All security services running normally</div>
                    </div>
                </div>
            </div>
        </div>

    </div>
</div>
