@page "/mailbox"
@using WhistleblowerPlatform.Client.Services
@inject CryptoService CryptoService
@inject WhistleblowerService WbService

<div class="hero-section">
    <div style="max-width: 720px; margin: 0 auto;">

        <div class="text-center mb-5">
            <h1>Check Report Status</h1>
            <p class="lead">Enter your anonymous token to view the status of your report and communicate with investigators.</p>
        </div>

        @if (_caseStatus == null)
        {
            <div class="submit-form-card">
                <label class="form-label">Enter Your Token</label>
                <div class="d-flex gap-3">
                    <div class="flex-grow-1" style="position: relative;">
                        <div style="position: absolute; left: 1.1rem; top: 50%; transform: translateY(-50%); color: var(--color-muted-fg); pointer-events: none;">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <rect x="3" y="11" width="18" height="11" rx="2"></rect>
                                <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
                            </svg>
                        </div>
                        <input type="text"
                               class="form-control"
                               style="padding-left: 3rem; font-family: monospace;"
                               placeholder="WB-XXXXXX-XXXXXX"
                               value="@_tokenInput"
                               @oninput="OnTokenInput" />
                    </div>
                    <button class="btn btn-primary px-4"
                            @onclick="CheckCase"
                            disabled="@(_checking || string.IsNullOrWhiteSpace(_tokenInput))">
                        @if (_checking)
                        {
                            <span class="spinner-border spinner-border-sm me-2"></span>
                        }
                        Search
                    </button>
                </div>

                @if (_error != null)
                {
                    <div class="alert alert-danger mt-3 mb-0">@_error</div>
                }

                <div class="info-panel mt-4">
                    <strong style="color: var(--color-foreground); font-size: 0.9rem;">Where is my token?</strong>
                    <ul>
                        <li>Your token was displayed immediately after you submitted your report.</li>
                        <li>It was also provided as part of your secure case link.</li>
                        <li>Tokens cannot be recovered — keep them safe.</li>
                    </ul>
                </div>
            </div>
        }
        else
        {
            <!-- Case header card -->
            <div class="submit-form-card mb-4">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <div style="font-size: 0.8rem; color: var(--color-muted-fg); text-transform: uppercase; letter-spacing: 0.05em; margin-bottom: 0.25rem;">Case Number</div>
                        <div style="font-size: 1.3rem; font-weight: 600; font-family: monospace;">@_caseStatus.CaseNumber</div>
                    </div>
                    <span class="badge @StatusBadgeClass(_caseStatus.Status)" style="font-size: 0.85rem; padding: 0.5rem 0.9rem;">@StatusLabel(_caseStatus.Status)</span>
                </div>
                <div class="mt-3 pt-3" style="border-top: 1px solid var(--color-border);">
                    <button class="btn btn-outline-secondary btn-sm" @onclick="Reset">Use a different token</button>
                </div>
            </div>

            <!-- Report text -->
            @if (_reportText != null)
            {
                <div class="submit-form-card mb-4">
                    <div style="font-size: 0.8rem; color: var(--color-muted-fg); text-transform: uppercase; letter-spacing: 0.05em; margin-bottom: 1rem;">Your Submitted Report</div>
                    <pre style="white-space: pre-wrap; word-break: break-word; font-size: 0.95rem; font-family: inherit; margin: 0; color: var(--color-foreground);">@_reportText</pre>
                </div>
            }

            <!-- Attachments -->
            @if (_attachments.Count > 0)
            {
                <div class="submit-form-card mb-4">
                    <div style="font-size: 0.8rem; color: var(--color-muted-fg); text-transform: uppercase; letter-spacing: 0.05em; margin-bottom: 1rem;">Attachments</div>
                    <ul class="list-group list-group-flush">
                        @foreach (var att in _attachments)
                        {
                            <li class="list-group-item px-0 d-flex justify-content-between align-items-center" style="border-color: var(--color-border);">
                                <div>
                                    <div style="font-size: 0.9rem; font-weight: 500;">@att.FileName</div>
                                    <div style="font-size: 0.8rem; color: var(--color-muted-fg);">
                                        @FormatFileSize(att.FileSize) &middot;
                                        <span class="badge @SanitizationBadgeClass(att.SanitizationStatus)" style="font-size: 0.75rem;">@SanitizationBadgeLabel(att.SanitizationStatus)</span>
                                    </div>
                                    @if (_attachmentErrors.ContainsKey(att.AttachmentId))
                                    {
                                        <div style="font-size: 0.8rem; color: var(--color-destructive); margin-top: 0.25rem;">@_attachmentErrors[att.AttachmentId]</div>
                                    }
                                </div>
                                <button class="btn btn-outline-primary btn-sm"
                                        @onclick="() => DownloadAttachment(att)"
                                        disabled="@(_downloadingAttachment.ContainsKey(att.AttachmentId) && _downloadingAttachment[att.AttachmentId])">
                                    @if (_downloadingAttachment.ContainsKey(att.AttachmentId) && _downloadingAttachment[att.AttachmentId])
                                    {
                                        <span class="spinner-border spinner-border-sm me-1"></span>
                                    }
                                    Download
                                </button>
                            </li>
                        }
                    </ul>
                </div>
            }

            <!-- Messages -->
            <div class="submit-form-card">
                <div style="font-size: 0.8rem; color: var(--color-muted-fg); text-transform: uppercase; letter-spacing: 0.05em; margin-bottom: 1rem;">Messages</div>

                @if (_msgDecryptError != null)
                {
                    <div class="alert alert-danger">@_msgDecryptError</div>
                }

                @if (!_messages.Any())
                {
                    <p style="color: var(--color-muted-fg); font-size: 0.9rem; margin-bottom: 1.5rem;">No messages yet. Investigators will reply here.</p>
                }
                else
                {
                    <div class="mb-4">
                        @foreach (var msg in _messages)
                        {
                            <div class="d-flex @(msg.SenderRole == 0 ? "justify-content-end" : "justify-content-start") mb-3">
                                <div style="max-width: 75%; border-radius: var(--radius-lg); padding: 0.9rem 1.1rem; background-color: @(msg.SenderRole == 0 ? "var(--color-primary)" : "var(--color-muted-bg)"); color: @(msg.SenderRole == 0 ? "#fff" : "var(--color-foreground)");">
                                    <div style="font-size: 0.75rem; font-weight: 600; margin-bottom: 0.4rem; opacity: 0.75;">
                                        @(msg.SenderRole == 0 ? "Investigator" : "You") &middot; @msg.CreatedAt.ToString("dd MMM yyyy HH:mm")
                                    </div>
                                    @if (_decryptedMessages.TryGetValue(msg.MessageId, out var msgText))
                                    {
                                        <div style="white-space: pre-wrap; word-break: break-word; font-size: 0.9rem;">@msgText</div>
                                    }
                                    else if (msg.SenderRole == 1)
                                    {
                                        <div style="font-size: 0.85rem; font-style: italic; opacity: 0.7;">[Your message]</div>
                                    }
                                    else
                                    {
                                        <div style="font-size: 0.85rem; font-style: italic; opacity: 0.7;">Decrypting...</div>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                }

                <div style="border-top: 1px solid var(--color-border); padding-top: 1.5rem;">
                    <textarea class="form-control mb-3" rows="3"
                              placeholder="Type your reply..."
                              @bind="_replyText" @bind:event="oninput"
                              disabled="@_sending"></textarea>
                    @if (_sendError != null)
                    {
                        <div class="alert alert-danger mb-3">@_sendError</div>
                    }
                    <button class="btn btn-submit w-100"
                            @onclick="SendReply"
                            disabled="@(_sending || string.IsNullOrWhiteSpace(_replyText))">
                        @if (_sending)
                        {
                            <span class="spinner-border spinner-border-sm me-2"></span>
                        }
                        Send Reply
                    </button>
                </div>
            </div>
        }
    </div>
</div>

@code {
    private string _tokenInput = "";
    private bool _checking = false;
    private string? _error;
    private CaseStatusResult? _caseStatus;
    private string _tokenRaw = "";
    private string _tokenHash = "";
    private List<WbMessageModel> _messages = new List<WbMessageModel>();
    private Dictionary<Guid, string> _decryptedMessages = new Dictionary<Guid, string>();
    private string? _msgDecryptError;
    private string? _reportText;
    private string _wbPublicKey = "";
    private string _wbPrivateKeyBase64 = "";
    private List<WbAttachmentModel> _attachments = new List<WbAttachmentModel>();
    private Dictionary<Guid, bool> _downloadingAttachment = new Dictionary<Guid, bool>();
    private Dictionary<Guid, string> _attachmentErrors = new Dictionary<Guid, string>();
    private string _replyText = "";
    private bool _sending = false;
    private string? _sendError;

    private async Task CheckCase()
    {
        _checking = true;
        _error = null;
        StateHasChanged();
        try
        {
            var tokenHash = await CryptoService.HashTokenAsync(_tokenInput.Trim());
            var result = await WbService.GetCaseAsync(tokenHash);
            if (result is null)
            {
                _error = "Token not recognised. Please check and try again.";
                return;
            }
            _tokenRaw = _tokenInput.Trim();
            _tokenHash = tokenHash;
            _caseStatus = result;

            var mailbox = await WbService.GetMessagesAsync(tokenHash);
            if (mailbox != null)
                await DecryptMessagesAsync(mailbox);
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _checking = false;
            StateHasChanged();
        }
    }

    private async Task DecryptMessagesAsync(WbMailboxResult mailbox)
    {
        try
        {
            var wrappingKey = await CryptoService.HashTokenAsync(_tokenRaw);
            var wbKeyBytes = Convert.FromBase64String(mailbox.EncryptedWbPrivateKey);
            var wbKeyJson = System.Text.Encoding.UTF8.GetString(wbKeyBytes);
            var wbKeyEnc = System.Text.Json.JsonSerializer.Deserialize<EncryptedDataModel>(wbKeyJson,
                new System.Text.Json.JsonSerializerOptions { PropertyNameCaseInsensitive = true });
            if (wbKeyEnc == null) return;
            var wbPrivateKey = await CryptoService.DecryptSymmetricAsync(
                wbKeyEnc.Iv, wbKeyEnc.Ciphertext, wbKeyEnc.AuthTag, wrappingKey);

            _wbPrivateKeyBase64 = wbPrivateKey;
            _wbPublicKey = mailbox.WbPublicKey;
            _attachments = mailbox.Attachments;

            try
            {
                var reportKeyBase64 = Convert.ToBase64String(mailbox.ReportWbKeyEnvelope);
                var reportSymKey = await CryptoService.DecryptWithPrivateKeyAsync(reportKeyBase64, wbPrivateKey);
                var reportJson = System.Text.Encoding.UTF8.GetString(mailbox.ReportEncryptedContent);
                var reportEnc = System.Text.Json.JsonSerializer.Deserialize<EncryptedDataModel>(reportJson,
                    new System.Text.Json.JsonSerializerOptions { PropertyNameCaseInsensitive = true });
                if (reportEnc != null)
                {
                    var reportPlainBase64 = await CryptoService.DecryptSymmetricAsync(reportEnc.Iv, reportEnc.Ciphertext, reportEnc.AuthTag, reportSymKey);
                    _reportText = System.Text.Encoding.UTF8.GetString(Convert.FromBase64String(reportPlainBase64));
                }
            }
            catch { /* report decryption failure is non-fatal */ }

            _messages = mailbox.Messages;
            foreach (var msg in _messages)
            {
                try
                {
                    var keyEnvelopeBase64 = Convert.ToBase64String(msg.WbKeyEnvelope);
                    var symmetricKey = await CryptoService.DecryptWithPrivateKeyAsync(keyEnvelopeBase64, wbPrivateKey);
                    var contentJson = System.Text.Encoding.UTF8.GetString(msg.EncryptedContent);
                    var enc = System.Text.Json.JsonSerializer.Deserialize<EncryptedDataModel>(contentJson,
                        new System.Text.Json.JsonSerializerOptions { PropertyNameCaseInsensitive = true });
                    if (enc == null) continue;
                    var plaintextBase64 = await CryptoService.DecryptSymmetricAsync(enc.Iv, enc.Ciphertext, enc.AuthTag, symmetricKey);
                    _decryptedMessages[msg.MessageId] = System.Text.Encoding.UTF8.GetString(Convert.FromBase64String(plaintextBase64));
                }
                catch { /* skip undecryptable message */ }
            }
        }
        catch (Exception ex)
        {
            _msgDecryptError = $"Could not decrypt messages: {ex.Message}";
        }
    }

    private void OnTokenInput(ChangeEventArgs e)
    {
        var raw = e.Value?.ToString() ?? "";
        _tokenInput = System.Text.RegularExpressions.Regex.Replace(raw, @"[^A-Za-z0-9\-]", "");
    }

    private void Reset()
    {
        _caseStatus = null;
        _tokenInput = "";
        _tokenRaw = "";
        _tokenHash = "";
        _messages = new List<WbMessageModel>();
        _decryptedMessages = new Dictionary<Guid, string>();
        _msgDecryptError = null;
        _reportText = null;
        _wbPublicKey = "";
        _wbPrivateKeyBase64 = "";
        _attachments = new List<WbAttachmentModel>();
        _downloadingAttachment = new Dictionary<Guid, bool>();
        _attachmentErrors = new Dictionary<Guid, string>();
        _replyText = "";
        _sendError = null;
        _error = null;
    }

    private async Task SendReply()
    {
        _sending = true;
        _sendError = null;
        StateHasChanged();
        try
        {
            var publicKey = await WbService.GetInvestigatorPublicKeyAsync();
            if (publicKey == null) throw new Exception("Could not retrieve investigator public key.");

            var plaintextBase64 = await CryptoService.StringToBase64Async(_replyText);
            var symKey = await CryptoService.GenerateSymmetricKeyAsync();
            var enc = await CryptoService.EncryptSymmetricAsync(plaintextBase64, symKey);
            var contentJson = System.Text.Json.JsonSerializer.Serialize(enc);
            var encryptedContent = System.Text.Encoding.UTF8.GetBytes(contentJson);
            var encKeyBase64 = await CryptoService.EncryptWithPublicKeyAsync(symKey, publicKey);
            var encryptedKeyEnvelope = Convert.FromBase64String(encKeyBase64);
            var wbEncKeyBase64 = await CryptoService.EncryptWithPublicKeyAsync(symKey, _wbPublicKey);
            var wbKeyEnvelope = Convert.FromBase64String(wbEncKeyBase64);

            var request = new SendWbMessageRequest
            {
                EncryptedContent = encryptedContent,
                EncryptedKeyEnvelope = encryptedKeyEnvelope,
                WbKeyEnvelope = wbKeyEnvelope
            };
            var result = await WbService.SendReplyAsync(_tokenHash, request);
            if (result == null) throw new Exception("Failed to send message.");

            var sentText = _replyText;
            _replyText = "";
            var newMsg = new WbMessageModel
            {
                MessageId = result.MessageId,
                SenderRole = 1,
                EncryptedContent = encryptedContent,
                WbKeyEnvelope = wbKeyEnvelope,
                CreatedAt = result.CreatedAt
            };
            _messages.Add(newMsg);
            _decryptedMessages[result.MessageId] = sentText;
        }
        catch (Exception ex)
        {
            _sendError = ex.Message;
        }
        finally
        {
            _sending = false;
            StateHasChanged();
        }
    }

    private async Task DownloadAttachment(WbAttachmentModel att)
    {
        _downloadingAttachment[att.AttachmentId] = true;
        _attachmentErrors.Remove(att.AttachmentId);
        StateHasChanged();
        try
        {
            var blob = await WbService.GetAttachmentAsync(_tokenHash, att.AttachmentId);
            if (blob == null) throw new Exception("Could not retrieve attachment.");
            var result = await CryptoService.DecryptFileAttachmentAsync(
                blob.Iv, blob.Ciphertext, blob.AuthTag, blob.WbKeyEnvelope, _wbPrivateKeyBase64);
            await CryptoService.DownloadFileAsync(result.ContentBase64, blob.FileName, blob.MimeType);
        }
        catch (Exception ex)
        {
            _attachmentErrors[att.AttachmentId] = ex.Message;
        }
        finally
        {
            _downloadingAttachment[att.AttachmentId] = false;
            StateHasChanged();
        }
    }

    private static string SanitizationBadgeClass(byte status)
    {
        if (status == 2) return "bg-success";
        if (status == 3) return "bg-danger";
        if (status == 4) return "bg-secondary";
        return "bg-warning text-dark";
    }

    private static string SanitizationBadgeLabel(byte status)
    {
        if (status == 2) return "Sanitized";
        if (status == 3) return "Failed";
        if (status == 4) return "Skipped";
        return "Pending";
    }

    private static string FormatFileSize(long bytes)
    {
        if (bytes < 1024) return $"{bytes} B";
        if (bytes < 1024 * 1024) return $"{bytes / 1024} KB";
        return $"{bytes / (1024 * 1024)} MB";
    }

    private static string StatusLabel(byte status) => status switch
    {
        0 => "Submitted",
        1 => "Under Review",
        2 => "In Progress",
        3 => "Referred to Court",
        4 => "Closed",
        _ => "Unknown"
    };

    private static string StatusBadgeClass(byte status) => status switch
    {
        0 => "bg-secondary",
        1 => "bg-info text-dark",
        2 => "bg-warning text-dark",
        3 => "bg-primary",
        4 => "bg-success",
        _ => "bg-secondary"
    };

    private class EncryptedDataModel
    {
        public string Iv { get; set; } = "";
        public string Ciphertext { get; set; } = "";
        public string AuthTag { get; set; } = "";
    }
}
