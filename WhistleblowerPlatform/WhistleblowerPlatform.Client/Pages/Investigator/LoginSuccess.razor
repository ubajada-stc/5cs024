@page "/investigator/login-successful"
@using WhistleblowerPlatform.Client.Services
@inject InvestigatorKeyService KeyService

<div class="row justify-content-center mt-5">
    <div class="col-md-6">
        <div class="alert alert-success">
            <h4>Login Successful</h4>
            <p>You are authenticated and your encryption keypair is loaded.</p>
            <ul>
                <li><strong>Private key in memory:</strong> @(KeyService.HasPrivateKey ? "Yes" : "No")</li>
            </ul>
        </div>
    </div>
</div>
