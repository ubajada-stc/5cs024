@inherits LayoutComponentBase
@using WhistleblowerPlatform.Client.Services
@inject AuthService AuthService
@inject InvestigatorKeyService KeyService
@inject NavigationManager Navigation

<div class="page">
    <main>
        <div class="top-row px-4 d-flex justify-content-between align-items-center">
            <a href="/" class="btn btn-outline-primary btn-sm">Home</a>
            <div class="d-flex gap-2">
                @if (AuthService.AccessToken != null)
                {
                    <a href="investigator/cases" class="btn btn-outline-primary btn-sm">Investigator Cases</a>
                    <button class="btn btn-outline-secondary btn-sm" @onclick="HandleLogout">Logout</button>
                }
                else
                {
                    <a href="login" class="btn btn-outline-primary btn-sm">Login</a>
                }
            </div>
        </div>

        <article class="content px-4">
            @Body
        </article>
    </main>
</div>

@code {
    private async Task HandleLogout()
    {
        await AuthService.LogoutAsync();
        KeyService.Clear();
        Navigation.NavigateTo("/login");
    }
}
